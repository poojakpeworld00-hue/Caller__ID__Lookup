<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_holderVw"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- sits below the grid the same way the reference app stacks it: the grid is transparent, so
         the banner shows through, and opening the drawer or a side panel covers it -->
    <include
        android:id="@+id/default_launcher_bannerVw"
        layout="@layout/part_launcher_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/home_screen_gridVw"
        layout="@layout/part_home_screen_grid" />

    <include
        android:id="@+id/all_apps_fragmentVw"
        layout="@layout/board_all_apps"
        android:visibility="gone" />

    <include
        android:id="@+id/widgets_fragmentVw"
        layout="@layout/board_widgets"
        android:visibility="gone" />

    <include
        android:id="@+id/left_panelVw"
        layout="@layout/board_left_panel"
        android:visibility="gone" />

    <!-- The "−1" panel: the caller-ID app's own home UI, slid in on a fling RIGHT -->
    <include
        android:id="@+id/caller_panelVw"
        layout="@layout/board_caller_panel"
        android:visibility="gone" />

    <!-- one item_swipe_hint row per direction in `launcher_ads.home_hint.swipeHints`,
         inflated by HomeBoardActivity.showSwipeHint -->
    <LinearLayout
        android:id="@+id/swipe_hintVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#be000000"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone" />

    <View
        android:id="@+id/home_screen_popup_menu_anchorVw"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</RelativeLayout>
