<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_holderVw"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    
    <include
        android:id="@+id/default_launcher_bannerVw"
        layout="@layout/part_launcher_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" />

    <include
        android:id="@+id/home_screen_gridVw"
        layout="@layout/part_home_screen_grid" />

    <include
        android:id="@+id/all_apps_fragmentVw"
        layout="@layout/board_all_apps"
        android:visibility="gone" />

    <include
        android:id="@+id/widgets_fragmentVw"
        layout="@layout/board_widgets"
        android:visibility="gone" />

    <include
        android:id="@+id/left_panelVw"
        layout="@layout/board_left_panel"
        android:visibility="gone" />

    
    <include
        android:id="@+id/caller_panelVw"
        layout="@layout/board_caller_panel"
        android:visibility="gone" />

    <!-- Bottom-left pill: opens the app-content (caller) panel. -->
    <LinearLayout
        android:id="@+id/edge_pill_startVw"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="159dp"
        android:background="@drawable/form_edge_pill"
        android:clickable="true"
        android:contentDescription="@string/swipe_right_hint"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/edge_pill_start_iconVw"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/form_pill_mark"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/edge_pill_start_chevronsVw"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_swipe_chevrons"
            android:tint="#6B7280" />
    </LinearLayout>

    <!-- Bottom-right pill: opens the free-up-space panel. -->
    <LinearLayout
        android:id="@+id/edge_pill_endVw"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="159dp"
        android:background="@drawable/form_edge_pill"
        android:clickable="true"
        android:contentDescription="@string/swipe_left_hint"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/edge_pill_end_chevronsVw"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:rotation="180"
            android:src="@drawable/ic_swipe_chevrons"
            android:tint="#6B7280" />

        <ImageView
            android:id="@+id/edge_pill_end_iconVw"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/form_pill_mark_ink"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sym_cid_sparkle"
            android:tint="#FFFFFFFF" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/swipe_hintVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#be000000"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone" />

    <View
        android:id="@+id/home_screen_popup_menu_anchorVw"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</RelativeLayout>
