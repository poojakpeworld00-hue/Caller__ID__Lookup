<?xml version="1.0" encoding="utf-8"?>
<!--
     The launcher's "−1" side panel. Parked at x = -screenWidth and slid in on a fling RIGHT
     over the home grid, Discover-style. Its whole content is the caller-ID app's own four-tab
     home UI, committed into callerPanelContainer as a HomeShellFragment — the same fragment
     AppHomeActivity hosts, so the panel and the standalone home can never drift apart.

     The bottom banner mirrors AppHomeActivity's: same include, same ScreenAds key, loaded by
     CallPanel on first open (the launcher is not a FrameActivity, so nothing loads
     it automatically here).
-->
<com.callerid.number.lookup.home.shell.panels.CallPanel
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/caller_panel_holderVw"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:clickable="true"
    android:focusable="true">

    <!-- Bottom banner (loaded on first open, type from ScreenAds config). -->
    <include
        android:id="@+id/bannerSlotVw"
        layout="@layout/part_bottom_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

    <!-- Full-bleed hairline separating app content from the ad below -->
    <View
        android:id="@+id/callerAdBannerDividerVw"
        style="@style/AdDivider"
        android:layout_above="@id/bannerSlotVw" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/callerPanelContainerVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/callerAdBannerDividerVw" />

</com.callerid.number.lookup.home.shell.panels.CallPanel>
