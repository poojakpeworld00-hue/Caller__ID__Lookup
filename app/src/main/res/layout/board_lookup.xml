<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    
    <LinearLayout
        android:id="@+id/heroHeaderVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_10sdp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_extrabold"
            android:letterSpacing="-0.03"
            android:text="@string/nav_lookup"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_16ssp" />

        <ImageView
            android:id="@+id/padLookupHistory"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/form_onb_circle_lavender"
            android:contentDescription="@string/recent_lookups"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/sym_history"
            app:tint="@color/on_primary_container" />
    </LinearLayout>

    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/form_home_search"
        android:elevation="@dimen/_2sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingVertical="@dimen/_6sdp">

        <LinearLayout
            android:id="@+id/rowCountryPickerSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_6sdp">

            <TextView
                android:id="@+id/lblFlagSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textSize="@dimen/_12ssp"
                tools:text="🇮🇳" />

            <TextView
                android:id="@+id/lblCountrySearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_4sdp"
                android:drawableEnd="@drawable/sym_caret_down"
                android:drawablePadding="@dimen/_2sdp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                tools:text="+91" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@color/outline" />

        <EditText
            android:id="@+id/inpNumberInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/lookup_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="@dimen/_11ssp" />

        <ImageView
            android:id="@+id/picClear"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/sym_close"
            android:visibility="gone"
            app:tint="@color/on_surface_variant" />

        <ImageView
            android:id="@+id/padSearch"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:background="@drawable/form_circle_primary"
            android:contentDescription="@string/lookup_search_number"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/sym_search"
            app:tint="@color/on_primary" />
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/flagPaste"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/form_cta_pill"
        android:clickable="true"
        android:elevation="@dimen/_2sdp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@string/lookup_paste"
            android:src="@drawable/sym_paste"
            app:tint="@color/on_primary_container" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/lookup_paste"
            android:textColor="@color/on_primary_container"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblPasteNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/on_primary_container"
            android:textSize="@dimen/_11ssp"
            tools:text="+91 98220 41177" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shmResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/form_card_border"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <View
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:alpha="0.18"
                    android:background="@drawable/form_shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:alpha="0.18"
                    android:background="@drawable/form_shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:alpha="0.18"
                    android:background="@drawable/form_shimmer_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginVertical="@dimen/_14sdp"
                    android:alpha="0.12"
                    android:background="@color/on_surface_variant" />

                <View
                    android:layout_width="@dimen/_140sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:alpha="0.18"
                    android:background="@drawable/form_shimmer_placeholder" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrlContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/_16sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                
                <LinearLayout
                    android:id="@+id/cvResultVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/form_card_border"
                    android:orientation="vertical"
                    android:padding="@dimen/_13sdp"
                    android:visibility="gone">

                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/rowResActions"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.08"
                                android:text="@string/number_lookup"
                                android:textAllCaps="true"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_10ssp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/lblResName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/_2sdp"
                                    android:fontFamily="@font/nunito_bold"
                                    android:textColor="@color/on_surface"
                                    android:textSize="@dimen/_12ssp"
                                    tools:text="Unknown" />

                                <ImageView
                                    android:id="@+id/picRevealName"
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:layout_marginStart="@dimen/_6sdp"
                                    android:contentDescription="@string/lookup_unknown_caller"
                                    android:padding="@dimen/_2sdp"
                                    android:src="@drawable/sym_view"
                                    android:visibility="gone"
                                    app:tint="@color/primary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/lblResNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:fontFamily="@font/nunito_extrabold"
                                android:letterSpacing="-0.02"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_18ssp"
                                tools:text="+1 234 567 890" />

                            <TextView
                                android:id="@+id/lblResValid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:background="@drawable/form_pill"
                                android:backgroundTint="@color/success_soft"
                                android:drawablePadding="@dimen/_4sdp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="@dimen/_10sdp"
                                android:paddingVertical="@dimen/_5sdp"
                                android:textColor="@color/success"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold"
                                app:drawableStartCompat="@drawable/sym_verified"
                                app:drawableTint="@color/success"
                                tools:text="Valid number" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/rowResActions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentEnd="true"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/padResShare"
                                android:layout_width="@dimen/_38sdp"
                                android:layout_height="@dimen/_38sdp"
                                android:layout_marginEnd="@dimen/_6sdp"
                                android:padding="@dimen/_5sdp"
                                android:contentDescription="@string/lookup_carrier"
                                android:src="@drawable/sym_share" />

                            <ImageView
                                android:id="@+id/padResCall"
                                android:layout_width="@dimen/_35sdp"
                                android:layout_height="@dimen/_35sdp"
                                android:layout_margin="@dimen/_5sdp"
                                android:padding="@dimen/_8sdp"
                                android:background="@drawable/form_theme_selected"
                                android:contentDescription="@string/action_call"
                                app:backgroundTint="@color/success"
                                android:src="@drawable/sym_call"
                                />
                        </LinearLayout>
                    </RelativeLayout>

                    
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginVertical="@dimen/_5sdp"
                        android:background="@drawable/form_divider_dashed"
                        android:layerType="software" />

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/form_tile"
                            android:orientation="vertical"
                            android:padding="@dimen/_12sdp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:contentDescription="@string/lookup_country"
                                    android:src="@drawable/sym_language"
                                     />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_6sdp"
                                    android:text="@string/lookup_country"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="@dimen/_10ssp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/lblResCountry"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:fontFamily="@font/nunito_bold"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_12ssp"
                                tools:text="United States" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:background="@drawable/form_tile"
                            android:orientation="vertical"
                            android:padding="@dimen/_12sdp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:contentDescription="@string/lookup_carrier"
                                    android:src="@drawable/sym_sim_card"
                                    />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_6sdp"
                                    android:text="@string/lookup_carrier"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="@dimen/_10ssp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/lblResCarrier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:fontFamily="@font/nunito_bold"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_12ssp"
                                tools:text="AT&amp;T" />
                        </LinearLayout>
                    </LinearLayout>

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/form_tile"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:contentDescription="@string/lookup_line_type"
                                android:src="@drawable/sym_info"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_6sdp"
                                android:text="@string/lookup_line_type"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblResType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/nunito_bold"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_12ssp"
                            tools:text="Mobile" />
                    </LinearLayout>

                    
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/padShowFullDetail"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="@string/show_full_detail"
                        android:textAllCaps="false"
                        android:textSize="@dimen/_12ssp"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="@dimen/_24sdp"
                        app:iconGravity="textEnd"
                        app:iconSize="@dimen/_16sdp"
                        app:iconTint="@android:color/white" />
                </LinearLayout>

                
                <LinearLayout
                    android:id="@+id/rowEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_32sdp"
                    android:visibility="gone">

                    <com.callerid.number.lookup.home.screen.shared.GlowIconView
                        android:layout_width="@dimen/_76sdp"
                        android:layout_height="@dimen/_76sdp"
                        app:biv_disc="@drawable/form_empty_circle_tools"
                        app:biv_icon="@drawable/sym_search_plus"
                        app:biv_iconSize="@dimen/_32sdp"
                        app:biv_iconTint="@color/on_primary_container"
                        app:biv_ring="@drawable/form_ring_tools" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:fontFamily="@font/nunito_extrabold"
                        android:gravity="center"
                        android:letterSpacing="-0.02"
                        android:text="@string/lookup_empty_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_15ssp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:fontFamily="@font/nunito_regular"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/lookup_empty_sub"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_11ssp" />

                    <LinearLayout
                        android:id="@+id/padEmptySearch"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_18sdp"
                        android:background="@drawable/form_cta_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_20sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_empty_cta"
                            android:src="@drawable/sym_search"
                            app:tint="@color/on_primary_container" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:text="@string/lookup_empty_cta"
                            android:textColor="@color/on_primary_container"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                
                <LinearLayout
                    android:id="@+id/rowHistoryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lblHistoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_lookups"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblHistoryClearAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/_4sdp"
                        android:text="@string/clear_all"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rollHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:visibility="gone"
                    tools:listitem="@layout/cell_search_history" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

</LinearLayout>
