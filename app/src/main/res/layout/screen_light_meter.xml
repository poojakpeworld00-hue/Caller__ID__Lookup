<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lightRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".ui.tools.LightMeterActivity">

        <LinearLayout
            android:id="@+id/crownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_6sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/padBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/sym_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@string/tools_light"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintTop_toBottomOf="@id/crownBar">

            <LinearLayout
                android:id="@+id/contentVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/tool_layout_in"
                android:orientation="vertical">
                
                <FrameLayout
                    android:id="@+id/adNativeFrameVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmerVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/googlemidnative2" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:background="@drawable/form_card_border"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/pbLevelVw"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            app:indicatorColor="@color/primary"
                            app:indicatorSize="@dimen/_170sdp"
                            app:trackColor="@color/surface_2"
                            app:trackCornerRadius="@dimen/_8sdp"
                            app:trackThickness="@dimen/_12sdp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblLux"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_22ssp"
                                android:textStyle="bold"
                                tools:text="333" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.1"
                                android:text="@string/light_unit"
                                android:textAllCaps="true"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_18sdp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/padCapture"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_46sdp"
                            android:layout_marginEnd="@dimen/_6sdp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/_4sdp"
                            android:text="@string/light_capture"
                            android:textAllCaps="true"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/_14sdp"
                            app:icon="@drawable/sym_camera"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/_4sdp"
                            app:iconSize="@dimen/_14sdp"
                            app:iconTint="@color/white" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/padZero"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_46sdp"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:layout_weight="1"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/_4sdp"
                            android:text="@string/light_zero"
                            android:textAllCaps="true"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/_14sdp"
                            app:icon="@drawable/sym_refresh"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/_4sdp"
                            app:iconSize="@dimen/_14sdp" />
                    </LinearLayout>
                </LinearLayout>

                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/SimTile" android:layout_marginEnd="@dimen/_5sdp">

                        <TextView style="@style/BatteryStatLabel" android:text="@string/light_min" />

                        <TextView android:id="@+id/lblMin" style="@style/BatteryStatValue" tools:text="120 lx" />
                    </LinearLayout>

                    <LinearLayout style="@style/SimTile" android:layout_marginHorizontal="@dimen/_5sdp">

                        <TextView style="@style/BatteryStatLabel" android:text="@string/light_avg" />

                        <TextView android:id="@+id/lblAvg" style="@style/BatteryStatValue" tools:text="412 lx" />
                    </LinearLayout>

                    <LinearLayout style="@style/SimTile" android:layout_marginStart="@dimen/_5sdp">

                        <TextView style="@style/BatteryStatLabel" android:text="@string/light_max" />

                        <TextView android:id="@+id/lblMax" style="@style/BatteryStatValue" tools:text="890 lx" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/lblNoSensor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_24sdp"
            android:gravity="center"
            android:text="@string/light_no_sensor"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/crownBar" />

        
        <View
            android:id="@+id/adBannerDividerVw"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        
        <include
            layout="@layout/part_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
