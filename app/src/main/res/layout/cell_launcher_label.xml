<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_holderVw"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/small_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/small_margin"
    android:paddingBottom="@dimen/small_margin">

    <org.fossify.commons.views.MySquareImageView
        android:id="@+id/launcher_iconVw"
        android:layout_width="match_parent"
        android:layout_height="@dimen/launcher_icon_size"
        android:layout_gravity="center_horizontal|bottom" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/launcher_labelVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/launcher_iconVw"
        android:ellipsize="end"
        android:gravity="center_horizontal|top"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="14sp" />

    <View
        android:id="@+id/popup_anchorVw"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|top" />

    <!-- Shown only on a promo tile; GONE for real apps. -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/promo_badgeVw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/launcher_iconVw"
        android:layout_alignEnd="@+id/launcher_iconVw"
        android:background="@drawable/form_promo_badge"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:text="@string/drawer_promo_badge"
        android:textColor="#FFFFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

</RelativeLayout>
