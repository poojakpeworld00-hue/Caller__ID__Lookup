<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/onboarding_skipVw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="44dp"
        android:paddingHorizontal="10dp"
        android:text="@string/onboarding_skip"
        android:textColor="@color/cid_onb_muted"
        android:textSize="15sp" />

    <include
        android:id="@+id/onboarding_step_headerVw"
        layout="@layout/view_onboarding_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/onboarding_skipVw"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp" />


    <LinearLayout
        android:id="@+id/onboarding_footerVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <View
            android:id="@+id/ad_native_dividerVw"
            style="@style/AdDivider" />

        <FrameLayout
            android:id="@+id/ad_native_frameVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/ad_shimmerVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/googlemidnative" />

            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/onboarding_set_defaultVw"
            style="@style/OnboardingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="14dp"
            android:text="@string/onboarding_set_default" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/onboarding_footnoteVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onb_default_footnote"
            android:textColor="@color/cid_onb_muted"
            android:textSize="12sp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/onboarding_footerVw"
        android:layout_below="@id/onboarding_step_headerVw"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            
            <RelativeLayout
                android:id="@+id/onboarding_heroVw"
                android:layout_width="match_parent"
                android:layout_height="278dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:layout_width="192dp"
                    android:layout_height="192dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/form_onb_blob" />

                
                <ImageView
                    android:id="@+id/onboarding_sparkle_1Vw"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="62dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sym_cid_sparkle"
                    android:tint="@color/cid_onb_card_stroke" />

                <ImageView
                    android:id="@+id/onboarding_sparkle_2Vw"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="34dp"
                    android:layout_marginEnd="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sym_cid_sparkle"
                    android:tint="@color/cid_onb_card_stroke" />

                <ImageView
                    android:id="@+id/onboarding_sparkle_3Vw"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="108dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sym_cid_sparkle"
                    android:tint="@color/cid_onb_card_stroke" />

                
                <LinearLayout
                    android:id="@+id/onboarding_mockVw"
                    android:layout_width="138dp"
                    android:layout_height="252dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="-22dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/form_onb_phone_mock"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="16dp">

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbMockLabel"
                        android:layout_gravity="start"
                        android:alpha="0.6"
                        android:text="@string/onb_mock_clock"
                        android:textSize="7sp" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbMockLabel"
                        android:layout_marginTop="16dp"
                        android:alpha="0.75"
                        android:text="@string/onb_mock_incoming"
                        android:textSize="9sp" />

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/form_onb_mock_avatar"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/sym_cid_person"
                        android:tint="@color/cid_onb_on_mock" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbMockLabel"
                        android:layout_marginTop="10dp"
                        android:text="@string/onb_mock_unknown"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        style="@style/OnbMockLabel"
                        android:layout_marginTop="3dp"
                        android:alpha="0.7"
                        android:text="@string/onb_mock_number"
                        android:textSize="9sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/form_onb_mock_decline"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/sym_cid_call_decline"
                            android:tint="@color/cid_onb_on_mock" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/form_onb_mock_accept"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/sym_cid_call_accept"
                            android:tint="@color/cid_onb_on_mock" />

                    </LinearLayout>

                </LinearLayout>

                
                <LinearLayout
                    android:id="@+id/onboarding_chipVw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignStart="@id/onboarding_mockVw"
                    android:layout_alignTop="@id/onboarding_mockVw"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="158dp"
                    android:background="@drawable/form_onb_mock_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:rotation="-4">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/slot_shield_check"
                        android:tint="@color/cid_onb_on_mock" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            style="@style/OnbMockLabel"
                            android:alpha="0.6"
                            android:text="@string/onb_mock_attribution"
                            android:textSize="7sp" />

                        <org.fossify.commons.views.MyTextView
                            style="@style/OnbMockLabel"
                            android:text="@string/onb_mock_brand"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                
                <ImageView
                    android:id="@+id/onboarding_shieldVw"
                    android:layout_width="72dp"
                    android:layout_height="82dp"
                    android:layout_alignEnd="@id/onboarding_mockVw"
                    android:layout_alignTop="@id/onboarding_mockVw"
                    android:layout_marginTop="116dp"
                    android:layout_marginEnd="-46dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sym_cid_shield_phone" />

                <ImageView
                    android:id="@+id/onboarding_badgeVw"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignEnd="@id/onboarding_shieldVw"
                    android:layout_below="@id/onboarding_shieldVw"
                    android:layout_marginTop="-16dp"
                    android:layout_marginEnd="-10dp"
                    android:background="@drawable/form_onb_check_badge_light"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/sym_cid_tick"
                    android:tint="@color/cid_onb_accent" />

            </RelativeLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_titleVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/onb_default_title"
                android:textColor="@color/cid_onb_ink"
                android:textSize="27sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/onboarding_leadVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/onb_default_lead"
                android:textColor="@color/cid_onb_muted"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
