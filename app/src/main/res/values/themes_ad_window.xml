<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Full-screen ad activities (AdActivity, AudienceNetworkActivity): an opaque black window
         so the screen underneath does not show through the edge-to-edge status / navigation strips. -->
    <style name="Theme.AdWindow" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

</resources>
