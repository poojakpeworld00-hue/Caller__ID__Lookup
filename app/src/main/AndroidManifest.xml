<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />

        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <queries>
        <intent>
            <action android:name="android.telecom.action.CHANGE_PHONE_ACCOUNTS" />
        </intent>
    </queries>

    
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
    </queries>

    <application
        android:name=".LookupCoreApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallerIdLookup">

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.boot.LaunchGateActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.locale.LanguageSelectActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.consent.ConsentGateActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.consent.OverlayGateActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        
        <activity
            android:screenOrientation="portrait"
            android:name="com.callerid.admesh.surface.TipSheetActivity"
            android:exported="false"
            android:theme="@style/Theme.OverlayGuide" />

        
        <activity
            android:name=".shell.screens.RoleCoachActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.OverlayGuide" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.slides.SlideIntroActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.AppHomeActivity"
            android:exported="false" />

        
        
        <activity
            android:name=".shell.screens.HelloStepActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name=".shell.screens.HomeRoleGateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/OnboardingTheme" />

        <activity
            android:name=".shell.screens.HomeBoardActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/LauncherTheme">

            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".shell.screens.BoardSettingsActivity"
            android:configChanges="orientation"
            android:exported="false"
            android:label="@string/launcher_settings"
            android:parentActivityName=".shell.screens.HomeBoardActivity"
            android:theme="@style/LauncherBaseTheme" />

        <activity
            android:name=".shell.screens.MaskedAppsActivity"
            android:exported="false"
            android:label="@string/hidden_icons"
            android:parentActivityName=".shell.screens.BoardSettingsActivity"
            android:theme="@style/LauncherBaseTheme" />

        <activity
            android:name="org.fossify.commons.activities.CustomizationActivity"
            android:exported="false"
            android:label="@string/customize_colors"
            android:parentActivityName=".shell.screens.BoardSettingsActivity"
            android:theme="@style/LauncherBaseTheme" />

        
        <receiver
            android:name=".shell.signals.ScreenLockAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".shell.gadgets.DigitClockProvider"
            android:exported="false"
            android:label="@string/digital_clock_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/digital_clock_widget_info" />
        </receiver>

        <receiver
            android:name=".shell.gadgets.DialClockProvider"
            android:exported="false"
            android:label="@string/analog_clock_widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/analog_clock_widget_info" />
        </receiver>

        
        <activity
            android:screenOrientation="portrait"
            android:name=".permit.fullscreen.FsiGateActivity"
            android:exported="false" />

        
        <service
            android:name=".permit.fullscreen.FsiPollService"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.blocking.BlockCenterActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.prefs.SettingsHubActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.identify.CountryPickActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.identify.LookupResultActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.identify.LookupHistoryActivity"
            android:exported="false" />

        
        <activity
            android:screenOrientation="portrait"
            android:name=".screen.dialpad.DialPadActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.report.CallDetailActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.ToolboxActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.CompassToolActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.SpeedToolActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.TorchToolActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.LevelToolActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.BatteryToolActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.NoiseToolActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.SimInfoActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.LightMeterActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.StopwatchActivity"
            android:exported="false" />

        <activity
            android:screenOrientation="portrait"
            android:name=".screen.gadgetry.CountdownActivity"
            android:exported="false" />

        
        <activity
            android:name=".screen.ringing.RingScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OverlayGuide"
            android:turnScreenOn="true" />

        

        
        <receiver
            android:name=".runtime.incoming.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        
        <service
            android:name=".runtime.incoming.IdentOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="caller_id" />
        </service>

        
        <service
            android:name=".runtime.incoming.CallScreenService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        
        <service
            android:name=".screen.consent.OverlayWatchService"
            android:exported="false" />

        
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>


        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <activity
            android:screenOrientation="portrait"
            android:name="com.callerid.admesh.surface.PromoAnchorActivity"
            android:exported="false" />

        
        <activity
            android:name="com.callerid.admesh.surface.tally.ShellSurfaceScreen"
            android:launchMode="singleInstance"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        

        <service
            android:name="com.callerid.admesh.surface.tally.jobs.ShellJobRunner"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE">
            <intent-filter>
                <action android:name="com.firebase.jobdispatcher.ACTION_EXECUTE" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.callerid.admesh.surface.tally.signals.BootSignalReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
